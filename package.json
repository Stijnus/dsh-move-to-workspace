{
  "name": "dsh-move-to-workspace",
  "version": "0.1.13",
  "description": "Move a DeepSeek Harness conversation into another workspace: copies the transcript into a new session bound to the target folder, archives the original, and can register a new workspace folder from the picker.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "registry-doctor": "node scripts/registry-doctor.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "conversation",
    "session",
    "move"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "scripts/registry-doctor.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "catalog": {
      "summary": {
        "en": "Move a conversation into another workspace \u2014 or organize a whole folder of them at once \u2014 with the original archived and restorable.",
        "zh": "\u628a\u4f1a\u8bdd\u79fb\u52a8\u5230\u5176\u4ed6\u5de5\u4f5c\u533a\uff0c\u6216\u4e00\u6b21\u6574\u7406\u4e00\u4e2a\u6587\u4ef6\u5939\u4e0b\u7684\u5168\u90e8\u4f1a\u8bdd\uff1b\u539f\u4f1a\u8bdd\u5f52\u6863\u4e14\u53ef\u6062\u590d\u3002"
      },
      "category": "workflow"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stijnus/dsh-move-to-workspace.git"
  },
  "homepage": "https://github.com/Stijnus/dsh-move-to-workspace#readme",
  "bugs": {
    "url": "https://github.com/Stijnus/dsh-move-to-workspace/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  }
}
