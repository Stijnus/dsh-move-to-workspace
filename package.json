{
  "name": "dsh-move-to-workspace",
  "version": "0.1.11",
  "description": "Move a DeepSeek Harness conversation into another workspace: copies the transcript into a new session bound to the target folder, archives the original, and can register a new workspace folder from the picker.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "registry-doctor": "node scripts/registry-doctor.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "conversation",
    "session",
    "move"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "scripts/registry-doctor.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "catalog": {
      "summary": {
        "en": "Move a conversation into another workspace — or organize a whole folder of them at once — with the original archived and restorable.",
        "zh": "把会话移动到其他工作区，或一次整理一个文件夹下的全部会话；原会话归档且可恢复。"
      },
      "category": "workflow"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stijnus/dsh-move-to-workspace.git"
  },
  "homepage": "https://github.com/Stijnus/dsh-move-to-workspace#readme",
  "bugs": {
    "url": "https://github.com/Stijnus/dsh-move-to-workspace/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  }
}
